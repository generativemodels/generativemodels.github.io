---
const { tone = 'cyan' } = Astro.props as {
  tone?: 'cyan'
}
---

<div class={`paragraph-accent paragraph-accent--${tone}`}>
  <slot />
</div>

<style>
  .paragraph-accent {
    margin: 1.25em 0;
    padding: 0.85em 1em;
    border-left: 5px solid #06b6d4;
    background:
      linear-gradient(90deg, rgba(6, 182, 212, 0.15), rgba(6, 182, 212, 0.05)),
      #ecfeff;
    box-shadow: 0 8px 22px rgba(6, 182, 212, 0.10);
  }

  .paragraph-accent--cyan {
    border-left-color: #06b6d4;
  }

  .paragraph-accent :global(p:first-child) {
    margin-top: 0;
  }

  .paragraph-accent :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
