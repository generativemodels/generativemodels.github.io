---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import LessonLayout from '../../layouts/LessonLayout.astro';
import T from '../../components/typst/TypstMath.astro';
import EquationAccent from '../../components/numbering/EquationAccent.astro';
import ParagraphAccent from '../../components/numbering/ParagraphAccent.astro';
import { typstable } from '../../consts';
import { resetCounters } from '../../components/numbering/CountersTools';

export async function getStaticPaths() {
	const lessons = await getCollection('lessons');
	return lessons.map((lesson) => ({
		params: { slug: lesson.id },
		props: lesson,
	}));
}
type Props = CollectionEntry<'lessons'>;

const lesson = Astro.props;
resetCounters();
const { Content } = await render(lesson);

const components = {
	EquationAccent,
	PinkEquation: EquationAccent,
	ParagraphAccent,
	CyanParagraph: ParagraphAccent,
} as Record<string, any>
const typst = typeof lesson.data.typst === 'string' ? [lesson.data.typst] : lesson.data.typst as string[] ?? []
for (const k of typstable) {
	if (typst.includes(k)) {
		components[k] = T
	}
}
---

<LessonLayout {...lesson.data}>
	<Content components={ components } />
</LessonLayout>
