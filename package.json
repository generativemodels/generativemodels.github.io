{
  "name": "genmodels",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dfm:install": "pnpm --dir dfm-live-figure install",
    "build:dfm-figure": "pnpm --dir dfm-live-figure build-only --base=/dfm-live-figure/ && rm -rf public/dfm-live-figure && mkdir -p public/dfm-live-figure && cp -r dfm-live-figure/dist/* public/dfm-live-figure/",
    "dev": "astro dev",
    "build": "pnpm build:dfm-figure && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.4",
    "@astrojs/react": "^5.0.1",
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.1",
    "@jsdevtools/rehype-toc": "^3.0.2",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0-rc2",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0-rc2",
    "@myriaddreamin/typst.ts": "^0.7.0-rc2",
    "@types/jsdom": "^27.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.13.5",
    "astro-typst": "^0.12.3",
    "jsdom": "^27.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "rehype-toc": "^3.0.2",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.2",
    "unified": "^11.0.5"
  }
}
